# Database used by the Python API. SQLite is for local development only.
# Later swap for Supabase / Neon / Vercel Postgres, e.g. postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./salesview.db

# App configuration
APP_ENV=development

# Local dev: where Next.js forwards /api/analyze and /api/demo-analyze
FASTAPI_URL=http://127.0.0.1:8000

# Optional: call a separately hosted API instead of same-origin /api
# NEXT_PUBLIC_API_BASE_URL=
